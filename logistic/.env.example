# Server Configuration
PORT=8080

# PostgreSQL Configuration
DATABASE_URL=postgres://postgres:postgres@localhost:5432/logistics?sslmode=disable

# Redis Configuration
REDIS_URL=redis://localhost:6379

# NATS Configuration
NATS_URL=nats://localhost:4222
NATS_STREAM_NAME=LOGISTICS

# GHN Provider Configuration
GHN_API_URL=https://dev-online-gateway.ghn.vn
GHN_TOKEN=your_ghn_token_here
GHN_SHOP_ID=your_shop_id_here
GHN_WEBHOOK_SECRET=your_ghn_webhook_secret_here

# GHTK Provider Configuration
GHTK_API_URL=https://services.giaohangtietkiem.vn
GHTK_TOKEN=your_ghtk_token_here

# ViettelPost Provider Configuration
VIETTELPOST_API_URL=https://partner.viettelpost.vn/v2
VIETTELPOST_USERNAME=your_viettelpost_username
VIETTELPOST_PASSWORD=your_viettelpost_password
VIETTELPOST_SENDER_PROVINCE_ID=1
VIETTELPOST_SENDER_DISTRICT_ID=1
