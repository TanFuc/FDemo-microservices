{
    "settings": {
        "number_of_shards": 3,
        "number_of_replicas": 1,
        "analysis": {
            "analyzer": {
                "vietnamese_analyzer": {
                    "type": "custom",
                    "tokenizer": "standard",
                    "filter": [
                        "lowercase",
                        "asciifolding",
                        "vietnamese_stop"
                    ]
                },
                "autocomplete_analyzer": {
                    "type": "custom",
                    "tokenizer": "autocomplete_tokenizer",
                    "filter": [
                        "lowercase",
                        "asciifolding"
                    ]
                },
                "autocomplete_search": {
                    "type": "custom",
                    "tokenizer": "standard",
                    "filter": [
                        "lowercase",
                        "asciifolding"
                    ]
                }
            },
            "tokenizer": {
                "autocomplete_tokenizer": {
                    "type": "edge_ngram",
                    "min_gram": 2,
                    "max_gram": 20,
                    "token_chars": [
                        "letter",
                        "digit"
                    ]
                }
            },
            "filter": {
                "vietnamese_stop": {
                    "type": "stop",
                    "stopwords": [
                        "và",
                        "của",
                        "là",
                        "có",
                        "được",
                        "trong",
                        "cho",
                        "với",
                        "này",
                        "các",
                        "để",
                        "một",
                        "những",
                        "không",
                        "từ",
                        "như",
                        "khi",
                        "theo",
                        "vào",
                        "ra",
                        "lên",
                        "về",
                        "đến"
                    ]
                }
            }
        }
    },
    "mappings": {
        "properties": {
            "id": {
                "type": "keyword"
            },
            "name": {
                "type": "text",
                "analyzer": "vietnamese_analyzer",
                "fields": {
                    "keyword": {
                        "type": "keyword",
                        "ignore_above": 256
                    },
                    "autocomplete": {
                        "type": "text",
                        "analyzer": "autocomplete_analyzer",
                        "search_analyzer": "autocomplete_search"
                    }
                }
            },
            "slug": {
                "type": "keyword"
            },
            "description": {
                "type": "text",
                "analyzer": "vietnamese_analyzer"
            },
            "categoryId": {
                "type": "keyword"
            },
            "categoryName": {
                "type": "keyword"
            },
            "categoryPath": {
                "type": "keyword"
            },
            "brandId": {
                "type": "keyword"
            },
            "brandName": {
                "type": "keyword"
            },
            "price": {
                "type": "double"
            },
            "minPrice": {
                "type": "double"
            },
            "maxPrice": {
                "type": "double"
            },
            "thumbnail": {
                "type": "keyword",
                "index": false
            },
            "images": {
                "type": "keyword",
                "index": false
            },
            "status": {
                "type": "keyword"
            },
            "stock": {
                "type": "integer"
            },
            "soldCount": {
                "type": "integer"
            },
            "rating": {
                "type": "float"
            },
            "reviewCount": {
                "type": "integer"
            },
            "specs": {
                "type": "object",
                "dynamic": true
            },
            "variations": {
                "type": "nested",
                "properties": {
                    "sku": {
                        "type": "keyword"
                    },
                    "price": {
                        "type": "double"
                    },
                    "stock": {
                        "type": "integer"
                    },
                    "attributes": {
                        "type": "object",
                        "dynamic": true
                    }
                }
            },
            "metadata": {
                "type": "object",
                "dynamic": true,
                "properties": {
                    "isFlashSale": {
                        "type": "boolean"
                    },
                    "isBestSeller": {
                        "type": "boolean"
                    },
                    "isNewArrival": {
                        "type": "boolean"
                    },
                    "campaignId": {
                        "type": "keyword"
                    },
                    "tags": {
                        "type": "keyword"
                    }
                }
            },
            "tags": {
                "type": "keyword"
            },
            "createdAt": {
                "type": "date"
            },
            "updatedAt": {
                "type": "date"
            },
            "suggest": {
                "type": "completion",
                "analyzer": "vietnamese_analyzer",
                "preserve_separators": true,
                "preserve_position_increments": true,
                "max_input_length": 50
            }
        }
    }
}