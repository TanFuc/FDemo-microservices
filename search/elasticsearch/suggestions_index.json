{
  "settings": {
    "number_of_shards": 1,
    "number_of_replicas": 1,
    "analysis": {
      "analyzer": {
        "suggestion_analyzer": {
          "type": "custom",
          "tokenizer": "standard",
          "filter": ["lowercase", "asciifolding"]
        },
        "autocomplete_analyzer": {
          "type": "custom",
          "tokenizer": "edge_ngram_tokenizer",
          "filter": ["lowercase", "asciifolding"]
        },
        "autocomplete_search": {
          "type": "custom",
          "tokenizer": "standard",
          "filter": ["lowercase", "asciifolding"]
        }
      },
      "tokenizer": {
        "edge_ngram_tokenizer": {
          "type": "edge_ngram",
          "min_gram": 1,
          "max_gram": 25,
          "token_chars": ["letter", "digit", "whitespace"]
        }
      }
    }
  },
  "mappings": {
    "properties": {
      "id": {
        "type": "keyword"
      },
      "text": {
        "type": "text",
        "analyzer": "suggestion_analyzer",
        "fields": {
          "keyword": {
            "type": "keyword",
            "ignore_above": 256
          },
          "autocomplete": {
            "type": "text",
            "analyzer": "autocomplete_analyzer",
            "search_analyzer": "autocomplete_search"
          }
        }
      },
      "displayText": {
        "type": "text",
        "index": false
      },
      "type": {
        "type": "keyword"
      },
      "entityId": {
        "type": "keyword"
      },
      "entityType": {
        "type": "keyword"
      },
      "imageUrl": {
        "type": "keyword",
        "index": false
      },
      "category": {
        "type": "keyword"
      },
      "categoryId": {
        "type": "keyword"
      },
      "searchCount": {
        "type": "long"
      },
      "clickCount": {
        "type": "long"
      },
      "conversionCount": {
        "type": "long"
      },
      "score": {
        "type": "float"
      },
      "weight": {
        "type": "integer"
      },
      "isPromoted": {
        "type": "boolean"
      },
      "isTrending": {
        "type": "boolean"
      },
      "suggest": {
        "type": "completion",
        "analyzer": "simple",
        "preserve_separators": true,
        "preserve_position_increments": true,
        "max_input_length": 50,
        "contexts": [
          {
            "name": "type",
            "type": "category"
          },
          {
            "name": "language",
            "type": "category"
          },
          {
            "name": "category",
            "type": "category"
          }
        ]
      },
      "language": {
        "type": "keyword"
      },
      "isActive": {
        "type": "boolean"
      },
      "lastSearchedAt": {
        "type": "date"
      },
      "createdAt": {
        "type": "date"
      },
      "updatedAt": {
        "type": "date"
      }
    }
  }
}
