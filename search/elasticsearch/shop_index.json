{
  "settings": {
    "number_of_shards": 2,
    "number_of_replicas": 1,
    "analysis": {
      "analyzer": {
        "vietnamese_analyzer": {
          "type": "custom",
          "tokenizer": "standard",
          "filter": ["lowercase", "asciifolding", "vietnamese_stop"]
        },
        "autocomplete_analyzer": {
          "type": "custom",
          "tokenizer": "autocomplete_tokenizer",
          "filter": ["lowercase", "asciifolding"]
        },
        "autocomplete_search": {
          "type": "custom",
          "tokenizer": "standard",
          "filter": ["lowercase", "asciifolding"]
        }
      },
      "tokenizer": {
        "autocomplete_tokenizer": {
          "type": "edge_ngram",
          "min_gram": 1,
          "max_gram": 20,
          "token_chars": ["letter", "digit"]
        }
      },
      "filter": {
        "vietnamese_stop": {
          "type": "stop",
          "stopwords": ["và", "hoặc", "của", "là", "các", "có", "được", "cho", "với", "trong", "từ", "đến", "này", "đó", "như"]
        }
      }
    }
  },
  "mappings": {
    "properties": {
      "id": {
        "type": "keyword"
      },
      "name": {
        "type": "text",
        "analyzer": "vietnamese_analyzer",
        "fields": {
          "keyword": {
            "type": "keyword",
            "ignore_above": 256
          },
          "autocomplete": {
            "type": "text",
            "analyzer": "autocomplete_analyzer",
            "search_analyzer": "autocomplete_search"
          },
          "suggest": {
            "type": "completion",
            "analyzer": "simple",
            "preserve_separators": true,
            "preserve_position_increments": true,
            "max_input_length": 50
          }
        }
      },
      "slug": {
        "type": "keyword"
      },
      "description": {
        "type": "text",
        "analyzer": "vietnamese_analyzer"
      },
      "ownerId": {
        "type": "keyword"
      },
      "logoUrl": {
        "type": "keyword",
        "index": false
      },
      "bannerUrl": {
        "type": "keyword",
        "index": false
      },
      "address": {
        "type": "text",
        "analyzer": "vietnamese_analyzer"
      },
      "city": {
        "type": "keyword"
      },
      "province": {
        "type": "keyword"
      },
      "country": {
        "type": "keyword"
      },
      "location": {
        "type": "geo_point"
      },
      "categoryIds": {
        "type": "keyword"
      },
      "tags": {
        "type": "keyword"
      },
      "rating": {
        "type": "float"
      },
      "reviewCount": {
        "type": "long"
      },
      "responseRate": {
        "type": "float"
      },
      "productCount": {
        "type": "long"
      },
      "soldCount": {
        "type": "long"
      },
      "followerCount": {
        "type": "long"
      },
      "status": {
        "type": "keyword"
      },
      "isVerified": {
        "type": "boolean"
      },
      "isOfficialStore": {
        "type": "boolean"
      },
      "popularityScore": {
        "type": "float"
      },
      "qualityScore": {
        "type": "float"
      },
      "businessType": {
        "type": "keyword"
      },
      "yearsActive": {
        "type": "integer"
      },
      "freeShipping": {
        "type": "boolean"
      },
      "shipFrom": {
        "type": "keyword"
      },
      "metadata": {
        "type": "object",
        "enabled": false
      },
      "joinedAt": {
        "type": "date"
      },
      "createdAt": {
        "type": "date"
      },
      "updatedAt": {
        "type": "date"
      }
    }
  }
}
