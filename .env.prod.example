# TAFU Production Environment Variables
# Copy this file to .env.prod and fill in the values

# Deployment
VERSION=latest

# Database
DB_USER=postgres
DB_PASSWORD=your-secure-db-password

# JWT Secrets
JWT_SECRET=your-super-secret-jwt-key-min-32-chars
JWT_REFRESH_SECRET=your-super-secret-refresh-key-min-32-chars

# Internal Service Authentication
INTERNAL_SERVICE_KEY=your-internal-service-key-for-service-to-service-calls

# Payment Providers
STRIPE_SECRET_KEY=sk_live_xxxxxxxxxxxxx
MOMO_PARTNER_CODE=your-momo-partner-code
MOMO_ACCESS_KEY=your-momo-access-key
MOMO_SECRET_KEY=your-momo-secret-key

# Logistics Providers
GHN_API_URL=https://online-gateway.ghn.vn
GHN_TOKEN=your-ghn-token
GHN_SHOP_ID=your-ghn-shop-id

# Email (SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@example.com
SMTP_PASSWORD=your-smtp-password

# Object Storage (MinIO)
MINIO_ACCESS_KEY=your-minio-access-key
MINIO_SECRET_KEY=your-minio-secret-key
