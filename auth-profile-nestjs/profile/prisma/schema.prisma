generator client {
  provider = "prisma-client"
  output   = "../src/generated/client"
}

datasource db {
  provider = "postgresql"
}

model Profile {
  id     String @id @default(uuid()) @db.Uuid
  userId String @unique @map("user_id") @db.Uuid // Reference to Auth Service User

  // Basic Info
  displayName String    @map("display_name") @db.VarChar(100)
  email       String?   @db.VarChar(255)
  phone       String?   @db.VarChar(20)
  avatarUrl   String?   @map("avatar_url") @db.VarChar(500)
  coverUrl    String?   @map("cover_url") @db.VarChar(500)
  bio         String?   @db.VarChar(1000)
  dateOfBirth DateTime? @map("date_of_birth") @db.Date
  gender      String?   @db.VarChar(20) // MALE, FEMALE, OTHER...

  // Location
  countryCode String? @map("country_code") @db.VarChar(10)
  city        String? @db.VarChar(100)

  // Preferences (Language, concurrency, privacy, notifications...)
  preferences Json? @default("{}")

  // Membership
  membershipTier      String    @default("BRONZE") @map("membership_tier") @db.VarChar(20)
  loyaltyPoints       Int       @default(0) @map("loyalty_points")
  membershipExpiresAt DateTime? @map("membership_expires_at") @db.Timestamptz

  // Verification
  isPhoneVerified    Boolean @default(false) @map("is_phone_verified")
  isEmailVerified    Boolean @default(false) @map("is_email_verified")
  isIdentityVerified Boolean @default(false) @map("is_identity_verified")
  identityDocument   Json?   @map("identity_document")

  // Social
  followingShopIds String[] @default([]) @map("following_shop_ids")
  followersCount   Int      @default(0) @map("followers_count")

  // Stats (Denormalized)
  stats Json? @default("{}")

  // Common
  metadata     Json?     @default("{}")
  lastActiveAt DateTime? @map("last_active_at") @db.Timestamptz
  isDeleted    Boolean   @default(false) @map("is_deleted")
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  shopConfig ShopConfig?
  addresses  Address[]

  @@index([userId])
  @@index([email])
  @@index([phone])
  @@map("profiles")
}

model ShopConfig {
  id        String @id @default(uuid()) @db.Uuid
  profileId String @unique @map("profile_id") @db.Uuid

  shopId      String? @map("shop_id") @db.VarChar(50) // Legacy or external ID?
  shopName    String? @map("shop_name") @db.VarChar(100)
  shopSlug    String? @unique @map("shop_slug") @db.VarChar(100)
  description String? @db.Text
  logoUrl     String? @map("logo_url") @db.VarChar(500)
  bannerUrl   String? @map("banner_url") @db.VarChar(500)

  pickupAddressId String? @map("pickup_address_id") @db.Uuid

  businessType    String  @default("INDIVIDUAL") @map("business_type") @db.VarChar(20)
  businessLicense String? @map("business_license")
  taxId           String? @map("tax_id")

  bankAccount    Json? @map("bank_account")
  policies       Json?
  operatingHours Json? @map("operating_hours")
  socialLinks    Json? @map("social_links")

  verificationStatus String    @default("PENDING") @map("verification_status") @db.VarChar(20)
  verifiedAt         DateTime? @map("verified_at") @db.Timestamptz

  rating         Float    @default(0)
  totalReviews   Int      @default(0) @map("total_reviews")
  totalProducts  Int      @default(0) @map("total_products")
  totalOrders    Int      @default(0) @map("total_orders")
  totalFollowers Int      @default(0) @map("total_followers")
  joinedAt       DateTime @default(now()) @map("joined_at") @db.Timestamptz

  // Relations
  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@map("shop_configs")
}

model Address {
  id        String @id @default(uuid()) @db.Uuid
  profileId String @map("profile_id") @db.Uuid

  contactName String  @map("contact_name") @db.VarChar(100)
  phone       String  @db.VarChar(20)
  email       String? @db.VarChar(255)

  countryCode  String  @map("country_code") @db.VarChar(10)
  provinceCode String  @map("province_code") @db.VarChar(20)
  provinceName String? @map("province_name")
  districtCode String  @map("district_code") @db.VarChar(20)
  districtName String? @map("district_name")
  wardCode     String  @map("ward_code") @db.VarChar(20)
  wardName     String? @map("ward_name")

  streetAddress String  @map("street_address") @db.VarChar(500)
  apartment     String? @db.VarChar(100)
  postalCode    String? @map("postal_code") @db.VarChar(20)
  fullAddress   String? @map("full_address") @db.VarChar(1000)

  coordinates Json?

  type  String  @default("HOME") // HOME, OFFICE, OTHER
  label String? @db.VarChar(50)

  isDefault            Boolean @default(false) @map("is_default")
  isDefaultBilling     Boolean @default(false) @map("is_default_billing")
  isDefaultPickup      Boolean @default(false) @map("is_default_pickup")
  deliveryInstructions String? @map("delivery_instructions") @db.VarChar(500)

  isVerified Boolean   @default(false) @map("is_verified")
  verifiedAt DateTime? @map("verified_at") @db.Timestamptz

  isDeleted Boolean   @default(false) @map("is_deleted")
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@map("addresses")
}
