// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../node_modules/@prisma/client"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                String    @id @default(uuid()) @db.Uuid
  email             String    @unique @db.VarChar(255)
  emailVerified     Boolean   @default(false) @map("email_verified")
  emailVerifiedAt   DateTime? @map("email_verified_at") @db.Timestamptz
  phone             String?   @db.VarChar(20)
  phoneVerified     Boolean   @default(false) @map("phone_verified")
  passwordHash      String    @map("password_hash") @db.VarChar(255)
  passwordChangedAt DateTime? @map("password_changed_at") @db.Timestamptz

  // Profile
  fullName    String    @map("full_name") @db.VarChar(255)
  displayName String?   @map("display_name") @db.VarChar(100)
  avatarUrl   String?   @map("avatar_url") @db.VarChar(500)
  birthday    DateTime? @db.Date
  gender      String?   @db.VarChar(10)

  // Account Status
  status           String    @default("ACTIVE") @db.VarChar(20)
  suspensionReason String?   @map("suspension_reason") @db.Text
  suspendedUntil   DateTime? @map("suspended_until") @db.Timestamptz

  // Security
  twoFactorEnabled    Boolean   @default(false) @map("two_factor_enabled")
  twoFactorSecret     String?   @map("two_factor_secret") @db.VarChar(255)
  backupCodes         Json?     @map("backup_codes")
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime? @map("locked_until") @db.Timestamptz
  lastLoginAt         DateTime? @map("last_login_at") @db.Timestamptz
  lastLoginIp         String?   @map("last_login_ip") @db.VarChar(45)
  loginCount          Int       @default(0) @map("login_count")

  // Preferences
  language String @default("vi") @db.VarChar(10)
  currency String @default("VND") @db.VarChar(3)
  timezone String @default("Asia/Ho_Chi_Minh") @db.VarChar(50)

  // Marketing
  acceptsMarketing   Boolean   @default(false) @map("accepts_marketing")
  marketingOptedInAt DateTime? @map("marketing_opted_in_at") @db.Timestamptz

  // Referral
  referralCode String  @unique @map("referral_code") @db.VarChar(20)
  referredBy   String? @map("referred_by") @db.Uuid

  // OAuth
  googleId   String? @map("google_id") @db.VarChar(100)
  facebookId String? @map("facebook_id") @db.VarChar(100)
  appleId    String? @map("apple_id") @db.VarChar(100)

  // Metadata
  metadata Json?

  // Timestamps
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz

  // Relations
  userRoles UserRole[]

  @@index([email])
  @@index([phone])
  @@index([referralCode])
  @@index([googleId])
  @@index([facebookId])
  @@index([appleId])
  @@index([status, createdAt])
  @@map("users")
}

// Authorization Models (Synchronized with pkg/authorization)

model Policy {
  id          String   @id @default(uuid()) @db.VarChar(100) // pkg uses string/varchar(100)
  type        String   @db.VarChar(50) // rbac, abac, rule_based
  subject     String   @db.VarChar(200)
  object      String   @db.VarChar(200)
  action      String   @db.VarChar(100)
  effect      String   @default("allow") @db.VarChar(20)
  conditions  Json?    @db.JsonB
  priority    Int      @default(0)
  domain      String?  @db.VarChar(100)
  tenantId    String?  @map("tenant_id") @db.VarChar(100)
  description String?  @db.VarChar(500)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@index([domain])
  @@index([tenantId])
  @@map("authorization_policies")
}

model Role {
  id          String   @id @default(uuid()) @db.VarChar(100)
  name        String   @db.VarChar(200)
  description String?  @db.VarChar(500)
  parentId    String?  @map("parent_id") @db.VarChar(100)
  metadata    Json?    @db.JsonB
  domain      String?  @db.VarChar(100)
  tenantId    String?  @map("tenant_id") @db.VarChar(100)
  isActive    Boolean  @default(true) @map("is_active")
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // Self relation for hierarchy
  parent   Role?  @relation("RoleHierarchy", fields: [parentId], references: [id])
  children Role[] @relation("RoleHierarchy")

  // Relations
  permissions RolePermission[]
  userRoles   UserRole[]

  @@index([parentId])
  @@index([domain])
  @@index([tenantId])
  @@map("authorization_roles")
}

model Permission {
  id          String   @id @default(uuid()) @db.VarChar(100)
  resource    String   @db.VarChar(200)
  action      String   @db.VarChar(100)
  scope       String   @default("global") @db.VarChar(50)
  conditions  Json?    @db.JsonB
  description String?  @db.VarChar(500)
  domain      String?  @db.VarChar(100)
  tenantId    String?  @map("tenant_id") @db.VarChar(100)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  roles RolePermission[]

  @@index([domain])
  @@index([tenantId])
  @@map("authorization_permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.VarChar(100)
  permissionId String @map("permission_id") @db.VarChar(100)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("authorization_role_permissions")
}

model UserRole {
  id        String    @id @default(uuid()) @db.VarChar(100)
  userId    String    @map("user_id") @db.Uuid // Matches User.id (uuid)
  roleId    String    @map("role_id") @db.VarChar(100)
  domain    String?   @db.VarChar(100)
  tenantId  String?   @map("tenant_id") @db.VarChar(100)
  expiresAt DateTime? @map("expires_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([roleId])
  @@index([domain])
  @@index([tenantId])
  @@map("authorization_user_roles")
}
